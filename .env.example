# ContextShield - Environment Variables Template
# Copy this file to .env.local and fill in your Firebase project credentials.
# NOTE: These credentials are required for Cloud AI Analysis (Gemini Cloud via Firebase AI Logic).
# On-Device AI can run locally without Firebase when Chrome Prompt API is enabled.

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
